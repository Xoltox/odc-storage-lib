<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OdcStorage</RootNamespace>
    <AssemblyName>OdcStorageLib</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**;dist/**;publish/**" />
    <EmbeddedResource Remove="tests/**;dist/**;publish/**" />
    <None Remove="tests/**;dist/**;publish/**" />
    <EmbeddedResource Include="Resources/icon.png" LogicalName="OdcStorage.Resources.icon.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="OutSystems.ExternalLibraries.SDK" Version="1.7.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OdcStorageLib.UnitTests" />
  </ItemGroup>
</Project>
